# Docker Compose Postgres (host port 5433 to avoid the local postgres@15 on 5432)
DATABASE_URL="postgresql://eclora:eclora@localhost:5433/eclora?schema=public"
PORT=4000
JWT_SECRET="change-me"
CORS_ORIGIN="http://localhost:3000"

# Optional: set all four to store new admin uploads in a private Cloudflare R2
# bucket. Leave all four unset/empty for local disk storage. Keep real keys only
# in the server's .env, never in NEXT_PUBLIC_* variables or source control.
# Images remain available through /uploads/<filename>; no public bucket needed.
R2_BUCKET=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
